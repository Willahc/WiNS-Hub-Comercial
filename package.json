{
  "name": "wins_hub_unificado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && (cp -r dist/* /opt/winshub/spa/ && nginx -s reload || true)",
    "build:wave1": "tsc -b && vite build --mode wave1",
    "build:gate": "tsc -b && vite build --mode gate",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.18.1",
    "cytoscape": "^3.34.0",
    "keycloak-js": "^26.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
