# Configuração do backup — copie para .backup_env e ajuste
# chmod 600 .backup_env (contém chave SSH e webhook)

# Destino offsite (SCP)
OFFSITE_TARGET="user@backup.example.com:/home/user/backups_agro"

# Webhook de alerta (Slack/Discord/Google Chat)
ALERT_WEBHOOK="https://hooks.slack.com/services/xxx/yyy/zzz"

# Heartbeat (healthchecks.io ou similar)
HEARTBEAT_URL="https://hc-ping.com/seu-uuid-aqui"

# Chave GPG para cifragem
GPG_RECIPIENT="backup@winshubagro.cloud"
